# Normalize to LF in the repo, check out native on Windows
* text=auto

# Windows batch files MUST use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF even on Windows checkouts
*.sh text eol=lf

# Binaries
*.mp4 binary
*.mkv binary
*.webm binary
*.png binary
*.jpg binary
*.ico binary
